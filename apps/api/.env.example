PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/devdesk
# If using MongoDB Atlas and mongodb+srv:// fails to resolve (common behind
# some VPNs/DNS setups), use Atlas's non-SRV connection string instead:
# MONGODB_URI=mongodb://<user>:<password>@shard-00-00.xxxxx.mongodb.net:27017,shard-00-01.xxxxx.mongodb.net:27017,shard-00-02.xxxxx.mongodb.net:27017/devdesk?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
# Set to a strong random value in production.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN_MS=2592000000
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Optional — falls back to JWT_SECRET if unset.
OTP_HASH_SECRET=
